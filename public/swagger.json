{
  "openapi": "3.0.0",
  "info": {
    "title": "BotSync RAG System API",
    "description": "API для управления ассистентами и их базой знаний",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Основной сервер"
    }
  ],
  "paths": {
    "/callback": {
      "post": {
        "summary": "Дообучение ассистента через JSON",
        "description": "Принимает массив вопросов и ответов для добавления в базу знаний ассистента",
        "operationId": "assistantCallback",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallbackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешная индексация",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallbackResponse"
                }
              }
            }
          },
          "422": {
            "description": "Ошибка валидации"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CallbackRequest": {
        "type": "object",
        "required": [
          "assistant_id",
          "name",
          "chunks"
        ],
        "properties": {
          "assistant_id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "База ответов"
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "description": "Произвольный объект данных"
            }
          }
        }
      },
      "CallbackResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "assistant_id": {
            "type": "integer"
          },
          "knowledge_id": {
            "type": "integer"
          }
        }
      }
    }
  }
}
